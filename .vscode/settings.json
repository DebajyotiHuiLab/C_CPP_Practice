
{
    "C_Cpp.default.compilerPath": "C:/msys64/ucrt64/bin/gcc.exe",

    "C_Cpp.formatting": "clangFormat",
    "C_Cpp.clang_format_path": "C:/msys64/ucrt64/bin/clang-format.exe",
    "C_Cpp.clang_format_style": "file",

    "[c]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },

    "[cpp]": {
        "editor.defaultFormatter": "ms-vscode.cpptools",
        "editor.formatOnSave": true
    },

    "code-runner.runInTerminal": true,
    "code-runner.showRunIconInEditorTitle": true,
    "code-runner.saveFileBeforeRun": true,
    "code-runner.ignoreSelection": true,
    "code-runner.showExecutionMessage": true,

    "code-runner.executorMap": {
        "c": "Set-Location $dir; & \"C:\\msys64\\ucrt64\\bin\\gcc.exe\" -std=gnu23 -Wall -Wextra -g $fullFileName -o \"$workspaceRoot\\bin\\$fileNameWithoutExt.exe\"; if ($LASTEXITCODE -eq 0) { & \"$workspaceRoot\\bin\\$fileNameWithoutExt.exe\" }",

        "cpp": "Set-Location $dir; & \"C:\\msys64\\ucrt64\\bin\\g++.exe\" -std=gnu++20 -Wall -Wextra -g $fullFileName -o \"$workspaceRoot\\bin\\$fileNameWithoutExt.exe\"; if ($LASTEXITCODE -eq 0) { & \"$workspaceRoot\\bin\\$fileNameWithoutExt.exe\" }"
    }
}
